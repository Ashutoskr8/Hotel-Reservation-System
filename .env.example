# Copy to .env (with a loader such as django-environ in production) or set these in your shell.
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_NAME=db.sqlite3
# Production gateway credentials are deliberately not used by the mock payment service.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
